# Copy to deploy/.env and fill in. deploy/.env is git- and docker-ignored.

# Gates the Admin tab for anyone without an admin account (fallback). Use a long
# random value: `openssl rand -base64 24`.
S1DROPS_ADMIN_PASSWORD=

# Accounts. Emails listed here become admins on their first sign-in.
S1DROPS_ADMIN_EMAILS=
# Public address, no trailing slash, e.g. https://eviction-detection.example.ts.net
S1DROPS_PUBLIC_URL=

# Google sign-in (optional; leave empty for email + password only). From Google
# Cloud console > APIs & Services > Credentials > OAuth client ID (Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare route only (needs a domain on Cloudflare). Leave both commented for
# the free Tailscale Funnel route. Token: Zero Trust > Networks > Tunnels > your
# tunnel > install command (the long string after `--token`).
# COMPOSE_PROFILES=cloudflare
# CLOUDFLARE_TUNNEL_TOKEN=

# Host directory holding cache/ and lcz/. Created by deploy/bootstrap-vm.sh.
S1DROPS_DATA_DIR=/srv/s1drops

# Uncomment once lcz_cog.tif is at $S1DROPS_DATA_DIR/lcz/lcz_cog.tif.
# S1DROPS_LCZ_PATH=/data/lcz/lcz_cog.tif

# Container memory cap. ~2 GB below the VM's RAM is a sensible ceiling.
# S1DROPS_MEM_LIMIT=6g

# Operational limits (defaults shown).
# S1DROPS_NATIVE10_MAX_KM2=10
# S1DROPS_MAX_CUBE_BYTES=2000000000
