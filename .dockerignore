.git
.pytest_cache/
__pycache__/
*.pyc
*.egg-info/

# Virtualenvs and large local geodata must never enter the build context.
s1env/
.venv/
venv/
cache/
*.zarr/
*.tif
*.tiff

# Secrets: COPY . . in the Dockerfile would otherwise bake deploy/.env into the image.
.env
**/.env

# Credentials that may sit in the working tree; never bake them into an image.
*_pw.txt
*_pw
*password*
*passwd*
*secret*
*.key
*.pem
